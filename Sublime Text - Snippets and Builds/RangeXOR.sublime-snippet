int xor_1_n(int _num) {
    if(_num < 1) return 0;
    int _rem = _num % 4;
    if(_rem == 0) return _num;
    else if(_rem == 1) return 1;
    else if(_rem == 2) return (_num + 1);
    return 0;
}

int range_xor(int _l, int _r) {
    return (xor_1_n(_r) ^ xor_1_n(_l-1));
}
