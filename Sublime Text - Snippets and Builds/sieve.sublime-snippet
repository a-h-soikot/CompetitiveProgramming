	<content><![CDATA[
const int32_t mxn = 2e5 + 2;
vector<bool> prime(mxn+1, true);
vector<int> primes;

void sieve(){
    for(int i = 4; i < mxn; i+=2) prime[i] = false;
    for(int i = 3; i*i <= mxn; i+=2){
        if(prime[i]){
            for(int j = i*i; j <= mxn; j+=2*i)
                prime[j] = false;
        }
    } prime[0] = prime[1] = false;
    for(int i = 2; i < mxn; i++) {
        if(prime[i]) primes.pb(i);
    }
}
]]></content>
