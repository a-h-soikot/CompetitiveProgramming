const int32_t mxn = 2e5 + 2;
vector<int> divs[mxn];

void calculate_divisors() {
    for(int num = 1; num < mxn; num++) {
        for(int i = 1; i * i <= num; i++) {
            if(num % i == 0) {
                divs[num].push_back(i);
                if(num / i != i) {
                    divs[num].push_back(num / i);
                }
            }
        }
    }
}
