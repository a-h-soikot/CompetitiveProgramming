vector<int> get_prime_divisors(int num) {
    if(num < 2) return {};
    vector<int> prime_divisors;
    for(int i = 0; primes[i] * primes[i] <= num; i++) {
        if(num % primes[i]) continue;
        prime_divisors.push_back(primes[i]);
        while(num % primes[i] == 0) num /= primes[i];
    }
    if(num > 1) prime_divisors.push_back(num);

    return prime_divisors;
}
