class TrieNode {
public:
    TrieNode *arr[26];
    bool isEnd;

    TrieNode () {
        for(int i = 0; i < 26; i++) {
            arr[i] = nullptr;
        }
        isEnd = false;
    }
};

class Trie {
    TrieNode *root;

public:

    Trie () {
        root = new TrieNode();
    }

    void insert(string s) {
        int n = (int)s.size();
        TrieNode *node = root;

        for(int i = 0; i < n; i++) {
            int index = (int)(s[i] - 'a');
            if(node->arr[index] == nullptr) {
                node->arr[index] = new TrieNode();
            }
            node = node->arr[index];
        }
        node->isEnd = true;
    }

    bool search(string s) {
        int n = (int)s.size();
        TrieNode *node = root;

        for(int i = 0; i < n; i++) {
            int index = (int)(s[i] - 'a');
            if(node->arr[index] == nullptr) {
                return false;
            }
            node = node->arr[index];
        }
        return node->isEnd;
    }

    void print_trie () {
        print_trie("", this->root);
    }

    void print_trie (string prefix, TrieNode *node) {
        if(node == nullptr) return;
        if(node->isEnd) cout << prefix << '\n';

        for(int i = 0; i < 26; i++) {
            if(node->arr[i] != nullptr) {
                print_trie(prefix + (char)('a' + i), node->arr[i]);
            }
        }
    }
};
