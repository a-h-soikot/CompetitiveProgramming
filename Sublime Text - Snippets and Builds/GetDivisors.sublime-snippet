vector<int> get_divisors(int num) {
    vector<int> divisors;
    for(int i = 1; i * i <= num; i++) {
        if(num % i == 0) {
            divisors.push_back(i);
            if(num / i != i) divisors.push_back(num / i);
        }
    }
    return divisors;
}
